# Use this Dockerfile for a server that runs Whisper and participates in SIP calls.
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements*.txt /app/
RUN pip install --no-cache-dir -r /app/requirements-ai.txt -r /app/requirements-sip.txt
COPY backend/app /app/app
COPY web /app/web
COPY scripts /app/scripts
RUN mkdir -p /data/models
ENV VAANI_DATABASE_URL=sqlite:////data/vaani.db
ENV STT_MODEL_PATH=/data/models/faster-whisper-small
ENV PIPER_MODEL_PATH=/data/models/piper/voice.onnx
ENV VAANI_TELEPHONY_PROVIDER=livekit_sip
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
