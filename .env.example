VAANI_DATABASE_URL=sqlite:///./vaani.db
VAANI_SECRET_KEY=replace-with-a-long-random-secret
VAANI_BOOTSTRAP_PASSWORD=change-me-now
VAANI_PUBLIC_BASE_URL=https://your-public-host.example
VAANI_MEDIA_WS_URL=wss://your-public-host.example/api/telephony/twilio/media
VAANI_TWILIO_ENABLED=false
VAANI_ENABLE_OUTBOUND_CALLS=false
# Outbound phone transport: livekit_sip (default) or the legacy twilio adapter.
VAANI_TELEPHONY_PROVIDER=livekit_sip
VAANI_SIP_ENABLED=false
VAANI_MAX_CALL_SECONDS=900
LIVEKIT_URL=wss://your-livekit-host.example
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ORGANIZATION_ID=
TWILIO_INBOUND_AGENT_ID=
VAANI_CALL_START_HOUR=9
VAANI_CALL_END_HOUR=20
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
STT_MODEL_PATH=models/faster-whisper-small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
PIPER_HTTP_URL=http://127.0.0.1:5000
PIPER_BIN=piper
PIPER_MODEL_PATH=models/piper/voice.onnx
VIBEVOICE_MODEL_PATH=models/vibevoice-1.5b
VIBEVOICE_DEVICE_MAP=auto

